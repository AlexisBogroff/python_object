## Option
def count_production(l):
    sizes = {'S': 0, 'M': 0, 'L': 0}
    for size in sizes:
        sizes[size] = l.count(size)
    return sizes

l = ['S', 'M', 'L', 'S', 'L', 'S']  # utiliser une liste, pas un set
print(count_production(l))
